### SCQ_00048 ###
# GROUP BY with COUNT, for object with high multiplicity
# Sparqloscope query group-by-count-object-high-multiplicity
SELECT ?object (COUNT(?subject) AS ?count) {
?subject :assocType ?object .
} GROUP BY ?object ORDER BY DESC(?count) LIMIT 10


### SCQ_00049 ###
# GROUP BY with COUNT, for object with low multiplicity
# Sparqloscope query group-by-count-object-low-multiplicity
SELECT ?object (COUNT(?subject) AS ?count) {
?subject :reference ?object .
} GROUP BY ?object ORDER BY DESC(?count) LIMIT 10


### SCQ_00050 ###
# GROUP BY with COUNT, for object but not sorted by object
# Sparqloscope query group-by-count-object-wrong-sort-order
SELECT ?o1 (COUNT(?s) AS ?count) {
  ?s :assocType ?o1 .
  ?s :reference ?o2 .
} GROUP BY ?o1 ORDER BY DESC(?count) LIMIT 10


### SCQ_00051 ###
# GROUP BY with COUNT and MIN and MAX and SAMPLE
# Sparqloscope query group-by-complex-aggregate
SELECT ?o1 (COUNT(?s) AS ?count) (MIN(?s) AS ?min) (MAX(?s) AS ?max)
  (SAMPLE(?s) AS ?sample) {
  ?s :assocType ?o1 .
  ?s :reference ?o2 .
} GROUP BY ?o1 ORDER BY DESC(?count) LIMIT 10


### SCQ_00052 ###
# Implicit GROUP BY with COUNT on numeric predicate as baseline
# Sparqloscope query group-by-implicit-numeric-baseline
SELECT (COUNT(?o) AS ?count) { ?s :allele-count ?o. }


### SCQ_00053 ###
# Implicit GROUP BY with SUM on numeric predicate
# Sparqloscope query group-by-implicit-numeric-sum
SELECT (SUM(?o) AS ?sum) { ?s :allele-count ?o. }


### SCQ_00054 ###
# Implicit GROUP BY with MIN on numeric predicate
