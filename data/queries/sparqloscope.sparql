### SCQ_00084 ###
# Baseline for numeric queries
# Sparqloscope query numeric-baseline
SELECT (SUM(?o) AS ?sum)
WHERE { ?s :allele-count ?o }


### SCQ_00085 ###
# ABS function
# Sparqloscope query numeric-abs
SELECT (SUM(ABS(?o)) AS ?sum)
WHERE { ?s :allele-count ?o }


### SCQ_00086 ###
# CEIL function
# Sparqloscope query numeric-ceil
SELECT (SUM(CEIL(?o)) AS ?sum)
WHERE { ?s :allele-count ?o }


### SCQ_00087 ###
# FLOOR function
# Sparqloscope query numeric-floor
