### SCQ_00001 ###
# JOIN of a small and a large predicate
# Sparqloscope query join-2-small-large
SELECT (COUNT(*) AS ?count)
WHERE { ?s :intramembraneRegion ?o1 . ?s rdf:type ?o2 }


### SCQ_00002 ###
# JOIN of a large and a small predicate
# Sparqloscope query join-2-large-small
SELECT (COUNT(*) AS ?count)
WHERE { ?s rdf:type ?o1 . ?s :intramembraneRegion ?o2 }


### SCQ_00003 ###
# JOIN of two large predicates
# Sparqloscope query join-2-large-large
SELECT (COUNT(*) AS ?count)
WHERE { ?s rdf:type ?o1 . ?s :reference ?o2 }


### SCQ_00004 ###
# JOIN of two predicates with the largest possible result
# Sparqloscope query join-2-largest-result
SELECT (COUNT(*) AS ?count)
WHERE {
  ?s :positionalAnnotation ?o1 .
  ?s :variant ?o2 }


### SCQ_00005 ###
# JOIN of two large predicates with a reasonably large result
# Sparqloscope query join-2-large-large-with-large-result
SELECT (COUNT(*) AS ?count)
WHERE {
  ?s :reference ?o1 .
  ?s rdf:type ?o2 }


### SCQ_00006 ###
# JOIN of two large predicates with a small result
# Sparqloscope query join-2-large-large-with-small-result
SELECT (COUNT(*) AS ?count)
WHERE {
  ?s :experimentalContext ?o1 .
  ?s :fromXref ?o2 }


### SCQ_00007 ###
# JOIN star of three large predicates with the largest sum of join sizes
# Sparqloscope query join-3-star-largest-sum-of-join-sizes
SELECT (COUNT(*) AS ?count)
WHERE {
  ?s :provenance ?o1 .
  ?s :accession ?o2 .
  ?s rdf:type ?o3 .
}


### SCQ_00008 ###
# JOIN chain of three large predicates with the largest sum of join sizes
# Sparqloscope query join-3-chain-largest-sum-of-join-sizes
SELECT (COUNT(*) AS ?count)
WHERE {
  ?a :evidence ?b .
  ?b :reference ?c .
  ?c rdf:type ?d .
}


### SCQ_00009 ###
# JOIN star of many small predicates
# Sparqloscope query join-xlarge-star-on-small-predicates
SELECT (COUNT(*) AS ?count)
WHERE {
  ?s :intramembraneRegion ?o0 .
  ?s :mitochondrialTransitPeptide ?o1 .
  ?s :kineticVmax ?o2 .
  ?s :ecEnzymeName ?o3 .
  ?s :phDependence ?o4 .
  ?s rdfs:subClassOf ?o5 .
  ?s :notIn ?o6 .
  ?s rdfs:seeAlso ?o7 .
  ?s :kineticNote ?o8 .
  ?s :cdAntigenCdAntigen ?o9 .
  ?s :electrophysiologicalParameter ?o10 .
  ?s :category ?o11 .
  ?s :nonTerminalResidue ?o12 .
  ?s :negativeIsoformSpecificity ?o13 .
  ?s :fullRegionName ?o14 .
  ?s :temperatureDependence ?o15 .
  ?s :pharmaceutical ?o16 .
  ?s :shortRegionName ?o17 .
  ?s :editor ?o18 .
  ?s :selenocysteine ?o19 .
  ?s :city ?o20 .
  ?s :publisher ?o21 .
  ?s :innInternationalNonproprietaryNames ?o22 .
  ?s :allergen ?o23 .
  ?s :redoxPotential ?o24 .
}


### SCQ_00010 ###
# JOIN chain of many small predicates
# Sparqloscope query join-xlarge-chain-on-small-predicates
SELECT (COUNT(*) AS ?count)
WHERE {
  ?v0 :intramembraneRegion ?v1 .
  ?v1 :mitochondrialTransitPeptide ?v2 .
  ?v2 :kineticVmax ?v3 .
  ?v3 :ecEnzymeName ?v4 .
  ?v4 :phDependence ?v5 .
  ?v5 rdfs:subClassOf ?v6 .
  ?v6 :notIn ?v7 .
  ?v7 rdfs:seeAlso ?v8 .
  ?v8 :kineticNote ?v9 .
  ?v9 :cdAntigenCdAntigen ?v10 .
  ?v10 :electrophysiologicalParameter ?v11 .
  ?v11 :category ?v12 .
  ?v12 :nonTerminalResidue ?v13 .
  ?v13 :negativeIsoformSpecificity ?v14 .
  ?v14 :fullRegionName ?v15 .
  ?v15 :temperatureDependence ?v16 .
  ?v16 :pharmaceutical ?v17 .
  ?v17 :shortRegionName ?v18 .
  ?v18 :editor ?v19 .
  ?v19 :selenocysteine ?v20 .
  ?v20 :city ?v21 .
  ?v21 :publisher ?v22 .
  ?v22 :innInternationalNonproprietaryNames ?v23 .
  ?v23 :allergen ?v24 .
  ?v24 :redoxPotential ?v25 .
}


