WHERE { ?s rdfs:label ?object FILTER REGEX(?object, "^Com") }


### SCQ_00074 ###
# String length for large string predicate
# Sparqloscope query strlen
SELECT (SUM(STRLEN(?o)) AS ?checksum)  {
  ?s rdfs:label ?o . }


### SCQ_00075 ###
