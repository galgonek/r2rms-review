### SCQ_00041 ###
# UNION of two large predicates, no constraint
# Sparqloscope query union-no-constraint
SELECT (COUNT(*) AS ?count)
WHERE { { ?s rdf:type ?o } UNION { ?s :reference ?o } }


### SCQ_00042 ###
# UNION of two large predicates, constrained by a large predicate known to have join partners
# Sparqloscope query union-constraint-from-star
SELECT (COUNT(*) AS ?count) WHERE {
  { ?s :provenance ?o1 }
  UNION { ?s :accession ?o1 }
  ?s rdf:type ?o2
}


### SCQ_00043 ###
# UNION of two large predicates, constrained by a join with a small result
# Sparqloscope query union-constraint-small-join
SELECT (COUNT(*) AS ?count) WHERE {
  { ?s :experimentalContext ?o1 }
  UNION { ?s :assignedBy ?o1 }
  ?s :fromXref ?o2
}


### SCQ_00044 ###
# UNION of two large predicates, constrained by a join with a large result
# Sparqloscope query union-constraint-large-join
SELECT (COUNT(*) AS ?count) WHERE {
  { ?s :evidence ?o1 }
  UNION { ?s rdf:type ?o1 }
  ?s :quality ?o2
}


### SCQ_00045 ###
# UNION of two large predicates, constraint by restrictive FILTER
# Sparqloscope query union-constraint-filter-restrictive
SELECT (COUNT(*) AS ?count) WHERE {
  { ?s rdf:type ?o } UNION { ?s :reference ?o }
  FILTER (?s = ?o)
}


