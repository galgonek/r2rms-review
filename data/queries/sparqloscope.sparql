### SCQ_00060 ###
# GROUP BY with GROUP_CONCAT on string predicate with high subject multiplicity
# Sparqloscope query group-by-string-groupconcat
SELECT (SUM(STRLEN(?cat)) AS ?sum) {
{ SELECT (GROUP_CONCAT(?o; SEPARATOR=" ") AS ?cat) {
  ?s :accession ?o. } GROUP BY ?s } }


