### SCQ_00068 ###
# CONTAINS filter with fixed string of length 3
# Sparqloscope query regex-3-contains
SELECT (COUNT(*) AS ?count)
WHERE { ?s rdfs:label ?o FILTER CONTAINS(?o, "com") }


