WHERE { ?s :allele-count ?o }


### SCQ_00088 ###
# ROUND function
# Sparqloscope query numeric-round
SELECT (SUM(ROUND(?o)) AS ?sum)
WHERE { ?s :allele-count ?o }


### SCQ_00089 ###
# Addition
# Sparqloscope query numeric-add
SELECT (SUM(?o + ?o) AS ?sum)
WHERE { ?s :allele-count ?o }


### SCQ_00090 ###
# Greater than
# Sparqloscope query numeric-greater
SELECT (SUM(?o > 0) AS ?sum)
WHERE { ?s :allele-count ?o }


### SCQ_00091 ###
# Numeric FILTER that filters out 50 percent of the values
# Sparqloscope query numeric-filter-bin-search-fifty-fifty
SELECT (COUNT(?s) AS ?count) {
  ?s :allele-count ?o .
  FILTER (?o >= 1) }


### SCQ_00092 ###
# Numeric FILTER that filters out 70 percent of the values
# Sparqloscope query numeric-filter-bin-search-seventy-thirty
SELECT (COUNT(?s) AS ?count) {
  ?s :allele-count ?o .
  FILTER (?o >= 3) }


### SCQ_00093 ###
# Numeric FILTER that filters out 95 percent of the values
# Sparqloscope query numeric-filter-bin-search-ninetyfive-five
SELECT (COUNT(?s) AS ?count) {
  ?s :allele-count ?o .
  FILTER (?o >= 33) }


### SCQ_00094 ###
# FILTER that filters out most rows and has few results
# Sparqloscope query filter-few-results
SELECT (COUNT(?s) AS ?count) {
  ?s rdf:type ?o . FILTER (?s = ?o) }


### SCQ_00095 ###
# FILTER that filters out few rows and has many results
# Sparqloscope query filter-many-results
SELECT (COUNT(?s) AS ?count) {
  ?s rdf:type ?o . FILTER (?s != ?o) }


### SCQ_00096 ###
# FILTER on string predicate for only English literals
# Sparqloscope query filter-language-en
SELECT (COUNT(?s) AS ?count) {
  ?s :accession ?o . FILTER(LANG(?o) = "en") }


### SCQ_00097 ###
# YEAR function
# Sparqloscope query date-year
SELECT (SUM(YEAR(?o)) AS ?sum)
WHERE { ?s :ttlGenerationDate ?o }


### SCQ_00098 ###
# MONTH function
# Sparqloscope query date-month
SELECT (SUM(MONTH(?o)) AS ?sum)
WHERE { ?s :ttlGenerationDate ?o }


### SCQ_00099 ###
# DAY function
# Sparqloscope query date-day
SELECT (SUM(DAY(?o)) AS ?sum)
WHERE { ?s :ttlGenerationDate ?o }


### SCQ_00100 ###
# Total number of triples
# Sparqloscope query number-of-triples
SELECT (COUNT(?s) AS ?count)
WHERE { ?s ?p ?o }


### SCQ_00101 ###
# Total number of distinct subjects
# Sparqloscope query number-of-subjects
SELECT (COUNT(DISTINCT ?s) AS ?count)
WHERE { ?s ?p ?o }


### SCQ_00102 ###
# Total number of distinct predicates
# Sparqloscope query number-of-predicates
SELECT (COUNT(DISTINCT ?p) AS ?count)
WHERE { ?s ?p ?o }


### SCQ_00103 ###
# Total number of distinct objects
# Sparqloscope query number-of-objects
SELECT (COUNT(DISTINCT ?o) AS ?count)
WHERE { ?s ?p ?o }


### SCQ_00104 ###
# Total number of literals
# Sparqloscope query number-of-literals
SELECT (COUNT(?o) AS ?count)
WHERE { ?s ?p ?o FILTER ISLITERAL(?o) }


### SCQ_00105 ###
# Total number of blank nodes
# Sparqloscope query number-of-blank-nodes
SELECT (COUNT(?s) AS ?count)
WHERE { ?s ?p ?o FILTER ISBLANK(?s) }
