SELECT (MIN(?o) AS ?min) { ?s :allele-count ?o. }


### SCQ_00055 ###
# Implicit GROUP BY with MAX on numeric predicate
# Sparqloscope query group-by-implicit-numeric-max
SELECT (MAX(?o) AS ?max) { ?s :allele-count ?o. }


### SCQ_00056 ###
# Implicit GROUP BY with AVG on numeric predicate
# Sparqloscope query group-by-implicit-numeric-avg
SELECT (AVG(?o) AS ?avg) { ?s :allele-count ?o. }


### SCQ_00057 ###
# Implicit GROUP BY with COUNT on string predicate as baseline
# Sparqloscope query group-by-implicit-string-baseline
SELECT (COUNT(?o) AS ?count) { ?s :accession ?o. }


### SCQ_00058 ###
# Implicit GROUP BY with MIN on string predicate
